# انسخ هذا الملف إلى .env.local وعدّل القيم. لا تضع أي أسرار هنا: جميع متغيرات NEXT_PUBLIC_ تظهر للعموم في المتصفح.

# الرابط النهائي للموقع بدون شرطة في النهاية. على Cloudflare Pages (الفرع main) يُضبط تلقائيًا إلى https://etaadq8.com
NEXT_PUBLIC_SITE_URL=https://etaadq8.com

# رقم واتساب المتجر المعتمد بالصيغة الدولية بدون + أو مسافات: 965 ثم 8 أرقام
# اتركه فارغًا إلى حين اعتماد الرقم — سيعرض الموقع تنبيهًا بدل زر الإرسال.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# معلومات تواصل إضافية اختيارية (تظهر فقط عند تعبئتها)
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
