{
  "name": "etaad-store",
  "version": "0.1.0",
  "private": true,
  "description": "عتاد | ETAAD — متجر معدات وأدوات للصيانة والعمل في الكويت",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve-static.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "images": "node scripts/optimize-images.mjs",
    "brand": "node scripts/generate-brand-assets.mjs",
    "brand:banner": "node scripts/prepare-banner-logo.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "preview:build": "node scripts/build-preview.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "playwright-core": "1.63.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "type": "module"
}
